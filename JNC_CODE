// Function to simulate credits appearing from the bottom and scrolling upward
void playCredits(const vector<string>& credits, int screenHeight = 20, int delay = 200) {
    int totalLines = credits.size();
    
    // Start with blank lines to simulate starting from the bottom
    vector<string> screen(screenHeight, "");

    for (int i = 0; i < totalLines + screenHeight; ++i) {
        clearScreen();

        // Shift lines upward
        if (i < totalLines) {
            screen.push_back(credits[i]);
        } else {
            screen.push_back(""); // add blank line after all credits are displayed
        }
        if (screen.size() > screenHeight) {
            screen.erase(screen.begin()); // remove the top-most line
        }

        // Print the current state of the screen
        for (const string& line : screen) {
            cout << line << endl;
        }

        // Delay to control the speed of scrolling
        this_thread::sleep_for(chrono::milliseconds(delay));
    }
}

