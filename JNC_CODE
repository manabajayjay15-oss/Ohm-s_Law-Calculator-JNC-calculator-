void hideCursor() {
    cout << "\033[?25l";
}

void showCursor() {
    cout << "\033[?25h";
}

void moveCursorTo(int row, int col) {
    cout << "\033[" << row << ";" << col << "H";
}

void drawInverseSpiral(int width, int height, int steps, int delay_ms, int total_height) {
    int x = 1, y = 1;
    vector<pair<int, int>> directions = {{0, 1}, {1, 0}, {0, -1}, {-1, 0}};
    int dir = 0, segment_length = width, segment_passed = 0;
    int loading_bar_width = 50, current_progress = 0;
    vector<char> loading_animation = {'+', '-', 'x', '/'};
    int animation_index = 0;
    int dot_count = 0;
    int dot_update_counter = 0;
    int dot_update_threshold = 10;

    for (int i = 0; i < steps; ++i) {
        moveCursorTo(y, x);
        cout << "\033[36m*\033[0m" << flush;  
        current_progress = (i * loading_bar_width) / steps;
        moveCursorTo(total_height + 2, 1);
       
        cout << "\r";

        if (current_progress < loading_bar_width) {
            cout << "Loading please wait   ";
           
            for (int d = 0; d < 3; ++d) {
                cout << "\b \b";  
            }  
            if (dot_update_counter >= dot_update_threshold) {
                dot_count = (dot_count + 1) % 4;  
              dot_update_counter = 0;
            }
           for (int d = 0; d < dot_count; ++d) {
                cout << ".";  
            }
            dot_update_counter++;
            cout << "\n[";  
        } else {
            cout << "Done!\n[";
        }

       for (int j = 0; j < loading_bar_width; ++j) {
            if (j < current_progress) {
                cout << "\033[32m=\033[0m";  
            } else {
                cout << " ";
            }
        }

        cout << "] \033[33m" << (current_progress * 104) / loading_bar_width << "%\033[0m ";
       
        if (current_progress < loading_bar_width) {
            cout << loading_animation[animation_index] << flush;
            animation_index = (animation_index + 1) % loading_animation.size();
        }
        this_thread::sleep_for(chrono::milliseconds(delay_ms));
        x += directions[dir].second;
        y += directions[dir].first;
        segment_passed++;

        if (segment_passed == segment_length) {
            dir = (dir + 1) % 4;
            segment_passed = 0;
            if (dir == 0 || dir == 2) {
                width--;
                segment_length = width;
            } else {
                height--;
                segment_length = height;
            }
            segment_length = max(segment_length, 1);
        }
        cout.flush();  
    }
    moveCursorTo(total_height + 2, 1);
    cout << "\rDone!                             \n[";
    for (int j = 0; j < loading_bar_width; ++j) {
        cout << "\033[32m=\033[0m";  
    }
    cout << "] \033[33m100%\033[0m" << endl;  
}

void runSpiralAnimation() {
    hideCursor();
    const int width = 170, height = 6, steps = 1050, delay_ms = 25;
    int total_height = height + 3;
    drawInverseSpiral(width, height, steps, delay_ms, total_height);
    showCursor();
    cout << endl;
    cout << "Press Enter to continue...";
    cin.ignore();  
    cin.get();  
}

void typeEffect(const string& text, int delay = 10) {
    for (char c : text) {
        cout << c << flush;  
        this_thread::sleep_for(chrono::milliseconds(delay));  
    }
}

enum ValueType {
    VOLTAGE, CURRENT, RESISTANCE, POWER
};

struct CalculationHistory {
    string description;
    double value;
    ValueType type;
};

vector<CalculationHistory> history;

struct SelectedHistoryValue {
    string description;
    double value;
    ValueType type;
    bool isSet;
} selectedValue = {"", 0, VOLTAGE, false};  

void addToHistory(const string& description, double value, ValueType type) {
    history.push_back({description, value, type});
}

string getTypeAsString(ValueType type) {
    switch (type) {
        case VOLTAGE: return "Voltage (V)";
        case CURRENT: return "Current (A)";
        case RESISTANCE: return "Resistance (Ω)";
        case POWER: return "Power (W)";
        default: return "Unknown";
    }
}

void viewHistory() {
    if (history.empty()) {
        clearConsole();
        typeEffect("No history available.\n");
        cout << "============================\n";
        typeEffect("Press Enter to continue...");
        cin.ignore();
        cin.get();
        return;
    }
    clearConsole();
    typeEffect("\n--- Calculation History ---\n");
    for (size_t i = 0; i < history.size(); ++i) {
        cout << i + 1 << ". " << history[i].description
             << " = " << history[i].value << " (" << getTypeAsString(history[i].type) << ")" << endl;
    }
    typeEffect("\nOptions:\n");
    typeEffect("1. Choose a value to use for calculation\n");
    typeEffect("2. Clear history\n");
    typeEffect("3. Back to menu\n");
    int choice;
    cin >> choice;

    switch (choice) {
        case 1: {
            clearConsole();
            typeEffect("\n--- Calculation History ---\n");
            for (size_t i = 0; i < history.size(); ++i) {
                cout << i + 1 << ". " << history[i].description
                     << " = " << history[i].value << " (" << getTypeAsString(history[i].type) << ")" << endl;
            }
            int index;
            typeEffect("\nEnter the number of the value to use: ");
            cin >> index;
            if (index > 0 && index <= static_cast<int>(history.size())) {
                selectedValue.description = history[index - 1].description;
                selectedValue.value = history[index - 1].value;
                selectedValue.type = history[index - 1].type;
                selectedValue.isSet = true;
                 std::ostringstream valueStream;
                 valueStream << std::fixed << std::setprecision(2) << selectedValue.value;  
                 typeEffect("You chose: " + selectedValue.description + " = " + valueStream.str()
                     + " (" + getTypeAsString(selectedValue.type) + ")\n");
                typeEffect("You can now use this value for further calculations.\n");
                cout << "============================\n";
                typeEffect("Press Enter to continue...");
                cin.ignore();
                cin.get();
            } else {
                typeEffect("Invalid choice.\n");
                cout << "============================\n";
                typeEffect("Press Enter to continue...");
                cin.ignore();
                cin.get();
            }
            break;
        }
        case 2:
            clearConsole();
            history.clear();
            selectedValue = {"", 0, VOLTAGE, false};
            typeEffect("History cleared.\n");
            break;
        case 3:
            clearConsole();
            typeEffect("Returning to menu...\n");
            cout << "============================\n";
            typeEffect("Press Enter to continue...");
            cin.ignore();
            cin.get();
            break;
        default:
            clearConsole();
            typeEffect("Invalid option.\n");
            cout << "============================\n";
            typeEffect("Press Enter to continue...");
            cin.ignore();
            cin.get();
            break;
    }
}

double promptToUseStoredValue(const string& prompt, ValueType requiredType) {
    char useStored;
    if (selectedValue.isSet && selectedValue.type == requiredType) {
        std::ostringstream valueStream;
        valueStream << std::fixed << std::setprecision(2) << selectedValue.value;  
        typeEffect(prompt + " Would you like to use the stored value ("
             + selectedValue.description + " = " + valueStream.str()  + ")? (y/n): ");
        cin >> useStored;
        if (useStored == 'y' || useStored == 'Y') {
            return selectedValue.value;
        }
    }
    double value;
    typeEffect(prompt);
    cin >> value;
    return value;
}

string custom_to_string(double value, int precision) {
    ostringstream out;
    out << fixed << setprecision(precision) << value;
    return out.str();
}

void setNonBlockingInput(bool enable) {
    termios t;
    tcgetattr(STDIN_FILENO, &t);
    if (enable) {
        t.c_lflag &= ~ICANON;  
        t.c_lflag &= ~ECHO;    
        fcntl(STDIN_FILENO, F_SETFL, O_NONBLOCK);  
    } else {
        t.c_lflag |= ICANON;   
        t.c_lflag |= ECHO;     
        fcntl(STDIN_FILENO, F_SETFL, 0);  
    }
    tcsetattr(STDIN_FILENO, TCSANOW, &t);
}

void updateDotAnimation(int& dot_count, int& dot_update_counter, int dot_update_threshold) {
    for (int d = 0; d < 3; ++d) {
        cout << "\b \b";
    }
    if (dot_update_counter >= dot_update_threshold) {
        dot_count = (dot_count + 1) % 4;  
        dot_update_counter = 0;
    }
    cout << "\rEnter to continue";  
    for (int d = 0; d < dot_count; ++d) {
        cout << ".";
    }
    dot_update_counter++;
}

void dotsnimation() {
    int dot_count = 0;
    int dot_update_counter = 0;
    int dot_update_threshold = 10; 
    const int inactivity_threshold = 100; 
    int inactivity_counter = 0; 
   
    setNonBlockingInput(true);  

    while (inactivity_counter < inactivity_threshold) {
        updateDotAnimation(dot_count, dot_update_counter, dot_update_threshold);
        std::this_thread::sleep_for(std::chrono::milliseconds(100));  
        std::cout.flush();

        int ch = getchar();
        if (ch != EOF && ch == '\n') { 
            break;
        }

        if (ch == EOF) { 
            inactivity_counter++;
        } else { 
            inactivity_counter = 0;
        }
    }

    setNonBlockingInput(false); 
    std::cout << "\n"; 
}

